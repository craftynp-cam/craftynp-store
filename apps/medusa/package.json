{
  "name": "apps-medusa",
  "version": "0.0.1",
  "private": true,
  "description": "The Crafty NP Medusa backend.",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "reset-auth0-account": "medusa exec ./src/scripts/reset-auth0-test-account.ts",
    "list-carriers": "medusa exec ./src/scripts/list-shipstation-carriers.ts",
    "register-webhook": "medusa exec ./src/scripts/register-shipstation-webhook.ts",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc -p src/admin --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@craftynp/types": "workspace:*",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/auth": "2.18.0",
    "@medusajs/auth-google": "2.18.0",
    "@medusajs/caching": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/notification": "2.18.0",
    "@medusajs/payment-stripe": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@tanstack/react-query": "5.64.2",
    "pdf-lib": "^1.17.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "stripe": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
