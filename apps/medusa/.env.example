# Postgres connection. Matches the docker-compose.yml service at the repo root.
# Host port is 5433, not the default 5432, so this project's database does not
# collide with any other Postgres already running on the machine.
DATABASE_URL=postgres://medusa:medusa@localhost:5433/craftynp_store

# Redis connection. Provisioned by docker-compose.yml so the local stack mirrors
# the deployed topology, but medusa-config.ts does not read it yet — Medusa still
# falls back to the in-memory event bus, cache, and workflow engine. Wiring the
# Redis-backed modules up is tracked with the infrastructure work (CNP-16).
REDIS_URL=redis://localhost:6379

# Secret used to sign authentication tokens. Generate with:
#   openssl rand -base64 32
# Use a unique value per environment. Never reuse the local value in deployment.
JWT_SECRET=replace-me-with-a-random-32-byte-string

# Secret used to sign session cookies. Generate the same way as JWT_SECRET.
COOKIE_SECRET=replace-me-with-a-random-32-byte-string

# Comma-separated origins allowed to call the store API. The storefront's URL.
STORE_CORS=http://localhost:8000

# Comma-separated origins allowed to call the admin API. The admin is served by
# Medusa itself in development, so this is Medusa's own origin.
ADMIN_CORS=http://localhost:9000

# Comma-separated origins allowed to call the auth routes. Both of the above.
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Public URL of this backend. Used to build admin and callback links.
MEDUSA_BACKEND_URL=http://localhost:9000

# Auth0 tenant domain (including region), used to build the authorize,
# token, and userinfo URLs. Example: dev-xxxxxxxx.us.auth0.com — no
# https:// prefix.
AUTH0_DOMAIN=

# Client ID of the "Crafty NP Storefront" Regular Web Application in the
# Auth0 tenant.
AUTH0_CLIENT_ID=

# Client secret of the same application. Copy it from the Auth0 dashboard —
# it is never returned by the Auth0 Management API in full, so there is no
# way to script this one.
AUTH0_CLIENT_SECRET=

# Where Auth0 redirects after Universal Login. This is the *storefront's*
# callback route, not a Medusa URL, and must exactly match an entry in the
# application's Allowed Callback URLs.
AUTH0_CALLBACK_URL=http://localhost:8000/auth/callback

# Client ID of the "Crafty NP Admin" OAuth 2.0 Web application client in
# Google Cloud, used for Google Workspace SSO into the admin dashboard. This
# is a separate Google Cloud client from whatever Auth0's own Google social
# connection eventually uses, so misconfiguring one cannot lock out the other.
GOOGLE_ADMIN_CLIENT_ID=

# Client secret of the same Google Cloud OAuth client. Copy it from the
# Google Cloud console credentials page.
GOOGLE_ADMIN_CLIENT_SECRET=

# Where Google redirects after sign-in. This is the admin dashboard's own
# login page — the "Continue with Google Workspace" widget runs there and
# reads the OAuth code/state off the URL — and must exactly match an entry
# in the Google Cloud client's Authorized redirect URIs.
GOOGLE_ADMIN_CALLBACK_URL=http://localhost:9000/app/login

# The Google Workspace domain admin sign-in is restricted to (the `hd` claim
# on the verified profile, checked server-side — the `hd` param on the
# authorize URL alone is only a UI hint and does not enforce anything).
GOOGLE_ADMIN_ALLOWED_DOMAIN=

# Key used to encrypt TOTP MFA secrets at rest. Generate the same way as
# JWT_SECRET. Rotating this value invalidates every admin's enrolled
# authenticator app factor — they will need to re-enrol from Profile > MFA.
MFA_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-string

# ShipStation V2 API key (sandbox for local development). Not the ShipStation
# app — this is the separate ShipStation API / ShipEngine product, Free tier.
SHIPSTATION_API_KEY=

# Base URL of the ShipStation V2 API. Sandbox and production share this same
# host; the key above determines which environment is used.
SHIPSTATION_BASE_URL=https://api.shipstation.com/v2

# The USPS carrier_id from GET /v2/carriers for the connected account. Run
# `pnpm run list-carriers` once SHIPSTATION_API_KEY is set to find it — do
# not hand-craft this value. Not required for the module to boot (that would
# make the discovery script itself unbootable), only to scope requests to
# USPS once you have it.
SHIPSTATION_USPS_CARRIER_ID=

# Requests per minute before the rate limiter starts queueing. ShipStation's
# sandbox allows 20/min, production 200/min — set below the real ceiling.
SHIPSTATION_RATE_LIMIT_PER_MINUTE=20

# Milliseconds before a rate-estimate call is treated as timed out.
SHIPSTATION_TIMEOUT_MS=5000

# Retries attempted on a 429 before checkout shows a "shipping unavailable"
# error. There is no flat-rate fallback: a wrong shipping charge is worse
# than a shopper retrying, so a failed rate call blocks Continue instead.
SHIPSTATION_MAX_RETRIES=2

# Units sent to ShipStation for every rate-estimate request. Every product's
# weight/length/width/height in Medusa is stored in these same units.
SHIPSTATION_WEIGHT_UNIT=gram
SHIPSTATION_DIMENSION_UNIT=centimeter

# How long a normalized rate list is cached (server-side), keyed on
# destination + parcel weight/dimensions.
SHIPSTATION_RATE_CACHE_TTL_SECONDS=900

# Price and label of the "Standard Shipping" Medusa shipping option seeded
# onto the United States region (seed-us-region.ts). This is NOT a checkout
# fallback — a failed live-rate call blocks checkout rather than quoting a
# guessed price — it only seeds a real shipping_option row for the future
# cart-based checkout (CNP-53). Amount is in decimal major units (dollars).
SHIPPING_OPTION_DEFAULT_AMOUNT=6
SHIPPING_OPTION_DEFAULT_LABEL=Standard shipping

# Secret used to sign shipping-rate quote tokens so a shopper cannot tamper
# with the price between selecting a rate and placing an order. Generate the
# same way as JWT_SECRET — do not reuse JWT_SECRET here, the blast radius of
# each secret is different.
SHIPPING_QUOTE_SECRET=replace-me-with-a-random-32-byte-string

# Ship-from address for the US region's stock location and every ShipStation
# rate estimate. Real values — never commit the client's actual address to a
# public example; keep this blank in git and fill it in the real .env only.
SHIP_FROM_ADDRESS_1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY_CODE=US
