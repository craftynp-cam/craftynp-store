# Postgres connection. Matches the docker-compose.yml service at the repo root.
# Host port is 5433, not the default 5432, so this project's database does not
# collide with any other Postgres already running on the machine.
DATABASE_URL=postgres://medusa:medusa@localhost:5433/craftynp_store

# Redis connection. Provisioned by docker-compose.yml so the local stack mirrors
# the deployed topology, but medusa-config.ts does not read it yet — Medusa still
# falls back to the in-memory event bus, cache, and workflow engine. Wiring the
# Redis-backed modules up is tracked with the infrastructure work (CNP-16).
REDIS_URL=redis://localhost:6379

# Secret used to sign authentication tokens. Generate with:
#   openssl rand -base64 32
# Use a unique value per environment. Never reuse the local value in deployment.
JWT_SECRET=replace-me-with-a-random-32-byte-string

# Secret used to sign session cookies. Generate the same way as JWT_SECRET.
COOKIE_SECRET=replace-me-with-a-random-32-byte-string

# Comma-separated origins allowed to call the store API. The storefront's URL.
STORE_CORS=http://localhost:8000

# Comma-separated origins allowed to call the admin API. The admin is served by
# Medusa itself in development, so this is Medusa's own origin.
ADMIN_CORS=http://localhost:9000

# Comma-separated origins allowed to call the auth routes. Both of the above.
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Public URL of this backend. Used to build admin and callback links.
MEDUSA_BACKEND_URL=http://localhost:9000

# Auth0 tenant domain (including region), used to build the authorize,
# token, and userinfo URLs. Example: dev-xxxxxxxx.us.auth0.com — no
# https:// prefix.
AUTH0_DOMAIN=

# Client ID of the "Crafty NP Storefront" Regular Web Application in the
# Auth0 tenant.
AUTH0_CLIENT_ID=

# Client secret of the same application. Copy it from the Auth0 dashboard —
# it is never returned by the Auth0 Management API in full, so there is no
# way to script this one.
AUTH0_CLIENT_SECRET=

# Where Auth0 redirects after Universal Login. This is the *storefront's*
# callback route, not a Medusa URL, and must exactly match an entry in the
# application's Allowed Callback URLs.
AUTH0_CALLBACK_URL=http://localhost:8000/auth/callback

# Client ID of the "Crafty NP Admin" OAuth 2.0 Web application client in
# Google Cloud, used for Google Workspace SSO into the admin dashboard. This
# is a separate Google Cloud client from whatever Auth0's own Google social
# connection eventually uses, so misconfiguring one cannot lock out the other.
GOOGLE_ADMIN_CLIENT_ID=

# Client secret of the same Google Cloud OAuth client. Copy it from the
# Google Cloud console credentials page.
GOOGLE_ADMIN_CLIENT_SECRET=

# Where Google redirects after sign-in. This is the admin dashboard's own
# login page — the "Continue with Google Workspace" widget runs there and
# reads the OAuth code/state off the URL — and must exactly match an entry
# in the Google Cloud client's Authorized redirect URIs.
GOOGLE_ADMIN_CALLBACK_URL=http://localhost:9000/app/login

# The Google Workspace domain admin sign-in is restricted to (the `hd` claim
# on the verified profile, checked server-side — the `hd` param on the
# authorize URL alone is only a UI hint and does not enforce anything).
GOOGLE_ADMIN_ALLOWED_DOMAIN=

# Key used to encrypt TOTP MFA secrets at rest. Generate the same way as
# JWT_SECRET. Rotating this value invalidates every admin's enrolled
# authenticator app factor — they will need to re-enrol from Profile > MFA.
MFA_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-string

# ShipStation V2 API key (sandbox for local development). Not the ShipStation
# app — this is the separate ShipStation API / ShipEngine product, Free tier.
SHIPSTATION_API_KEY=

# Base URL of the ShipStation V2 API. Sandbox and production share this same
# host; the key above determines which environment is used.
SHIPSTATION_BASE_URL=https://api.shipstation.com/v2

# The USPS carrier_id from GET /v2/carriers for the connected account. Run
# `pnpm run list-carriers` once SHIPSTATION_API_KEY is set to find it — do
# not hand-craft this value. Not required for the module to boot (that would
# make the discovery script itself unbootable), only to scope requests to
# USPS once you have it.
SHIPSTATION_USPS_CARRIER_ID=

# Requests per minute before the rate limiter starts queueing. ShipStation's
# sandbox allows 20/min, production 200/min — set below the real ceiling.
SHIPSTATION_RATE_LIMIT_PER_MINUTE=20

# Milliseconds before a rate-estimate call is treated as timed out.
SHIPSTATION_TIMEOUT_MS=5000

# Milliseconds before a label purchase, void, full rate call, or label PDF
# download is treated as timed out. Deliberately far longer than
# SHIPSTATION_TIMEOUT_MS: a rate estimate blocks a shopper at checkout and
# should fail fast, while a label purchase spends money at the carrier and is
# never retried, so cutting it short turns a successful purchase into an
# unconfirmed one that has to be reconciled by hand.
SHIPSTATION_LABEL_TIMEOUT_MS=30000

# Where bought shipping labels are stored. Cloudflare R2 in production, and
# the MinIO container from docker-compose.yml locally — R2 is S3-compatible,
# so the same client and bucket layout work against both and only the
# endpoint and credentials change.
#
# The bucket must stay private. A label carries the customer's name and full
# address, and is only ever served through the authenticated admin route at
# /admin/fulfilment/labels/:orderId. R2 has no object-level ACLs, so a bucket
# is public or private as a whole — do not reuse the bucket that serves
# site-content images.
#
# REGION is "auto" for R2. FORCE_PATH_STYLE must stay true for MinIO and is
# harmless on R2.
LABEL_STORAGE_ENDPOINT=http://localhost:9002
LABEL_STORAGE_REGION=auto
LABEL_STORAGE_BUCKET=craftynp-labels
LABEL_STORAGE_ACCESS_KEY_ID=craftynp
LABEL_STORAGE_SECRET_ACCESS_KEY=craftynp-local-secret
LABEL_STORAGE_FORCE_PATH_STYLE=true

# Whether label purchases are test labels, which cost nothing and are not
# real postage. Defaults to true — anything other than the literal "false"
# leaves test mode on, so a fresh clone can never spend money by accident.
# Set to false in production, and for the one live verification run.
SHIPSTATION_TEST_LABELS=true

# Retries attempted on a 429 before checkout shows a "shipping unavailable"
# error. There is no flat-rate fallback: a wrong shipping charge is worse
# than a shopper retrying, so a failed rate call blocks Continue instead.
SHIPSTATION_MAX_RETRIES=2

# Units sent to ShipStation for every rate-estimate request. Every product's
# weight/length/width/height in Medusa is stored in these same units.
SHIPSTATION_WEIGHT_UNIT=gram
SHIPSTATION_DIMENSION_UNIT=centimeter

# How long a normalized rate list is cached (server-side), keyed on
# destination + parcel weight/dimensions.
SHIPSTATION_RATE_CACHE_TTL_SECONDS=900

# Publicly reachable https URL of this backend's /hooks/shipstation/track
# route. `pnpm run register-webhook` subscribes it to ShipStation's `track`
# event so delivery progress arrives by push — polling on a timer is the
# usual way to exhaust the rate limit and is deliberately not done. ShipStation
# allows one URL per event and answers 409 if one is already registered.
# ShipStation will not deliver to localhost, so use a tunnel in development.
SHIPSTATION_WEBHOOK_URL=

# JWKS endpoint holding the public keys ShipStation signs webhooks with. Take
# the value from ShipStation's own webhook documentation for your environment.
# There is deliberately no default: the receiver fails closed when this is
# unset, because an unverified tracking endpoint would let anyone mark an
# order delivered.
SHIPSTATION_JWKS_URL=

# How far the x-shipengine-timestamp header may be from now before a webhook
# is rejected as a replay. A valid signature alone does not make a request
# fresh.
SHIPSTATION_WEBHOOK_MAX_AGE_SECONDS=300

# Price and label of the "Standard Shipping" Medusa shipping option seeded
# onto the United States region (seed-us-region.ts). This is NOT a checkout
# fallback — a failed live-rate call blocks checkout rather than quoting a
# guessed price — it only seeds a real shipping_option row for the future
# cart-based checkout (CNP-53). Amount is in decimal major units (dollars).
SHIPPING_OPTION_DEFAULT_AMOUNT=6
SHIPPING_OPTION_DEFAULT_LABEL=Standard shipping

# Per-IP request ceilings, per minute, on the four store routes a bot can reach
# without signing in. Two of them spend real money on every call — tax-quote
# bills a Stripe Tax calculation, shipping-rates burns the ShipStation limit,
# and because there is deliberately no flat-rate fallback, exhausting
# ShipStation blocks checkout for genuine customers. These are ceilings for
# abuse, not for normal use: a shopper editing an address a few times stays
# well inside them. Leave unset to take the defaults shown. A value that is not
# a positive integer is ignored rather than applied, so a typo cannot lock
# every caller out.
RATE_LIMIT_TAX_QUOTE_PER_MINUTE=20
RATE_LIMIT_SHIPPING_RATES_PER_MINUTE=20
RATE_LIMIT_PREPARE_CART_PER_MINUTE=20
RATE_LIMIT_CHECKOUT_COMPLETE_PER_MINUTE=10

# Secret used to sign shipping-rate quote tokens so a shopper cannot tamper
# with the price between selecting a rate and placing an order. Generate the
# same way as JWT_SECRET — do not reuse JWT_SECRET here, the blast radius of
# each secret is different.
SHIPPING_QUOTE_SECRET=replace-me-with-a-random-32-byte-string

# Ship-from address for the US region's stock location, every ShipStation rate
# estimate, and the return address printed on every label. Real values — never
# commit the client's actual address to a public example; keep these blank in
# git and fill them in the real .env only.
#
# NAME and PHONE are label-only. /v2/rates/estimate never needed them, but
# /v2/rates and /v2/labels both reject a ship_from without them, and the phone
# is what a carrier calls when a parcel cannot be delivered. COMPANY and
# ADDRESS_2 are optional; COMPANY prints above the name when set.
SHIP_FROM_NAME=
SHIP_FROM_PHONE=
SHIP_FROM_COMPANY=
SHIP_FROM_ADDRESS_1=
SHIP_FROM_ADDRESS_2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY_CODE=US

# Stripe secret key (sandbox/test mode for local development). Used for both
# Stripe Tax and Stripe payments (PaymentIntents, CNP-53).
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (Dashboard > Developers >
# Webhooks, or printed by `stripe listen` for local development). Verifies
# that a POST to /hooks/payment/stripe_stripe genuinely came from Stripe.
STRIPE_WEBHOOK_SECRET=

# Default Stripe Tax product tax code applied to every line item, since the
# shop sells one broad category of goods. txcd_99999999 is Stripe's "General -
# Tangible Goods" code. A per-product override can be layered in later without
# changing the tax-quote route's contract.
STRIPE_TAX_DEFAULT_TAX_CODE=txcd_99999999

# Stripe Tax code applied to the shipping line, so each state's own
# shipping-taxability rule is honoured. txcd_92010001 is Stripe's generic
# "Shipping" code.
STRIPE_TAX_SHIPPING_TAX_CODE=txcd_92010001

# Milliseconds before a tax calculation call is treated as timed out.
STRIPE_TAX_TIMEOUT_MS=5000

# Network retries the Stripe SDK attempts before a tax calculation fails and
# checkout shows a "tax unavailable" error. Same no-fallback stance as
# shipping: a wrong tax charge is worse than a shopper retrying.
STRIPE_TAX_MAX_RETRIES=2

# How long a calculated tax amount is cached (server-side), keyed on
# destination + shipping amount + line items.
STRIPE_TAX_CACHE_TTL_SECONDS=900

# Secret used to sign tax-quote tokens so a shopper cannot tamper with the
# calculated tax between checkout and order placement. Generate the same way
# as JWT_SECRET — do not reuse SHIPPING_QUOTE_SECRET or JWT_SECRET here, the
# blast radius of each secret is different.
TAX_QUOTE_SECRET=replace-me-with-a-random-32-byte-string

# ---------------------------------------------------------------------------
# Order confirmation
# ---------------------------------------------------------------------------

# Where the storefront is served from. Used to build the absolute order link
# that goes into confirmation emails — the backend has no other way to know
# the storefront's origin.
STOREFRONT_URL=http://localhost:8000

# Secret used to sign order-access tokens, which let a guest open their own
# order from an email link without an account. The token is bound to one order
# id, so a valid token cannot be pointed at somebody else's order. Generate the
# same way as JWT_SECRET — do not reuse SHIPPING_QUOTE_SECRET, TAX_QUOTE_SECRET
# or JWT_SECRET here, the blast radius of each secret is different.
ORDER_ACCESS_SECRET=replace-me-with-a-random-32-byte-string

# How long an order-access token stays valid. Far longer than the 30-minute
# quote tokens on purpose: a link sitting in a guest's inbox has to outlive
# production and shipping.
ORDER_ACCESS_TOKEN_TTL_DAYS=90

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------

# Resend API key. The template bodies live in Resend, not in this repo — see
# the "Email and notifications" section of AGENTS.md.
RESEND_API_KEY=re_replace_me

# Sender the transactional emails go out as. Must be on a domain verified in
# Resend, or every send is rejected. See README.md for the DNS records.
RESEND_FROM_EMAIL=The Crafty NP <orders@thecraftynp.org>

# Where a customer's reply lands. The confirmation email invites a reply to
# change an order before production, so this needs to be a real inbox.
RESEND_REPLY_TO=hello@thecraftynp.org

# Milliseconds before a send is treated as timed out.
RESEND_TIMEOUT_MS=5000

# Retries on a timeout or 5xx before the notification row is marked failed and
# left for the retry job. A 4xx is never retried — it fails identically.
RESEND_MAX_RETRIES=2

# Resend's free tier allows 100 emails a day on one custom domain. Once the
# remaining allowance drops to this number, every send logs [email:quota-low]
# at warn so the cap is noticed before mail starts bouncing off it.
RESEND_DAILY_QUOTA_ALERT_THRESHOLD=20

# Postal address shown in the email footer, which CAN-SPAM requires on
# commercial mail. Kept in env so the client's real address stays out of git.
SHOP_POSTAL_ADDRESS=The Crafty NP
