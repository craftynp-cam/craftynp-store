{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    // `@craftynp/types` points at the package's build output, not its source:
    // the source uses NodeNext `./customization.js` specifiers that Turbopack's
    // Bundler-mode resolver cannot follow. Turbo builds the package first
    // (`dependsOn: ["^build"]`), so `dist/` is always present. The mapping
    // targets `index.d.ts` directly, not the adjacent `index.js` — with
    // `allowJs` on, pointing at the `.js` file makes TypeScript infer the
    // module's exports from that file's own (value-only) re-exports, silently
    // dropping every type-only `export type { ... }` that has no JS-emit
    // trace, such as `SiteContent`.
    "paths": {
      "@/*": ["./src/*"],
      "@craftynp/types": ["../../packages/types/dist/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
