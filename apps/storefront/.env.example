# Base URL of the Medusa backend. In local development this is the Medusa app
# from apps/medusa; in deployment it is the Railway service URL.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key scoping storefront requests to a sales channel. The
# initial data seed is a migration script, so `npm run db:migrate` is what
# creates this key during first-time setup. The seed logs it, so the value is
# printed in that command's own output, as:
#
#   info: Publishable API key: pk_...
#
# Copy it from there and paste it here. That is the path to use on a fresh
# clone; it needs nothing but the migrate step you have already run.
#
# The key can also be read from the admin under Settings -> Publishable API
# Keys, but that route requires an admin user to log in with, and neither the
# migration nor the seed creates one.
#
# `npm run db:seed` is only for re-seeding a reset database: it runs that same
# script outside the migration ledger, so on an already-seeded database it mints
# a second key and duplicates the products.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Country code of the region the storefront defaults to before the shopper
# chooses one. Must match a region the seeded data creates. Before CNP-51 no
# seeded region contained "us", so this value silently fell back to the
# Europe region (selectDefaultRegion's regions[0] fallback) instead of
# actually matching. `seed-us-region.ts` now seeds a USD "United States"
# region, which is what this value is meant to resolve to — a USPS shipping
# quote next to a EUR subtotal would be an incoherent pairing.
NEXT_PUBLIC_DEFAULT_REGION=us

# Auth0 tenant domain (including region). Used server-side only, to build
# the sign-out URL — never exposed to the browser, so it is not prefixed
# NEXT_PUBLIC_. Must match apps/medusa/.env.example's AUTH0_DOMAIN.
AUTH0_DOMAIN=

# Client ID of the "Crafty NP Storefront" Regular Web Application. Also
# server-side only — the storefront never talks to Auth0 directly except to
# build this logout URL; the client secret lives only in apps/medusa/.env.
AUTH0_CLIENT_ID=

# This site's own base URL, used to build the absolute callback_url sent to
# Medusa's /auth/customer/auth0 route and the returnTo sent to Auth0's
# logout endpoint.
NEXT_PUBLIC_SITE_URL=http://localhost:8000
