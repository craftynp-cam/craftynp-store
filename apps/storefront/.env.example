# Base URL of the Medusa backend. In local development this is the Medusa app
# from apps/medusa; in deployment it is the Railway service URL.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key scoping storefront requests to a sales channel. Medusa
# generates it during `npm run db:seed`; copy the printed pk_... value here, or
# find it in the admin under Settings -> Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Country code of the region the storefront defaults to before the shopper
# chooses one. Must match a region created by the seed step.
NEXT_PUBLIC_DEFAULT_REGION=us
