{
  "name": "craftynp-store",
  "version": "0.0.0",
  "private": true,
  "description": "The Crafty NP storefront monorepo",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run services:up && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=apps/medusa",
    "db:seed": "npm run seed --workspace=apps/medusa"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
